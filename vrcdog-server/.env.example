VRCDOG_HOST=0.0.0.0
VRCDOG_PORT=11451
VRCDOG_DATA_FILE=./data/server-state.json
# Compose host port. Keep it loopback-only behind the 1Panel reverse proxy.
VRCDOG_BIND_PORT=21451
# Production override. MUST be a valid BCrypt hash of your admin password.
# If you delete this line, the built-in default (bcrypt hash of "root") is used.
# Generate a new one with:
#   docker run --rm httpd:2.4-alpine htpasswd -bnBC 12 '' 'your_password' | tr -d ':\n'
VRCDOG_SERVER_PASSWORD_BCRYPT='$2b$12$go9qphFk80mBGkPx9AiayObfu.gfsSvKCAL0sBMnTBYreWAGYDBiK'
RUST_LOG=vrcdog_server=info,tower_http=info
