{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCDog",
  "version": "5.0.0",
  "identifier": "com.vrcenvbuilder.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRC狗狗管家",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KingXiaoTaoOVO/VRCDog/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QkQ2M0I3QTEzRUM3ODAKUldTQXh6Nmh0Mk85V1QwUzNtSFRjMnVWdlMyM2Y4c3pKcm5sMDJDM2Q1L2o3S2tBMDhXVlJ4TUwK"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["bin/ffmpeg"],
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "OVRAS/*"
    ],
    "windows": {
      "nsis": {
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
