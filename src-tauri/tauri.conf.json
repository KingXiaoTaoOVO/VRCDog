{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCDog",
  "version": "5.0.0",
  "identifier": "com.vrcenvbuilder.dev",
  "build": {
    "beforeDevCommand": "node scripts/kill-port-1420.mjs && pnpm exec vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRCDog",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KingXiaoTaoOVO/VRCDog/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QkQ2M0I3QTEzRUM3ODAKUldTQXh6Nmh0Mk85V1QwUzNtSFRjMnVWdlMyM2Y4c3pKcm5sMDJDM2Q1L2o3S2tBMDhXVlJ4TUwK"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "bin/ffmpeg"
    ],
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "OVRAS/*",
      "vrcdog_actions.json",
      "bindings_index.json",
      "bindings_vive.json",
      "bindings_touch.json",
      "bindings_pico_neo3.json",
      "bindings_pico4.json",
      "bindings_wmr.json",
      "bindings_cosmos.json",
      "bindings_hpmotion.json",
      "../src-python/*.py",
      "../src-python/midishow-downloader/package.json",
      "../src-python/midishow-downloader/dist/*",
      "../src-python/midishow-downloader/node_modules/**/*",
      "../src-python/songs/*"
    ],
    "windows": {
      "wix": {
        "template": "wix/main.wxs",
        "language": {
          "en-US": {
            "localePath": "wix/locale.wxl"
          }
        }
      },
      "nsis": {
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
