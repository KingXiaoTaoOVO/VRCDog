{
  "name": "Default bindings for VrcDog (Vive Cosmos)",
  "controller_type": "vive_cosmos_controller",
  "last_edited_by": "VrcDog",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "mode": "button",
          "path": "/user/hand/right/input/trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/TranslateTrigger"
            }
          }
        },
        {
          "mode": "button",
          "path": "/user/hand/right/input/grip",
          "inputs": {
            "click": {
              "output": "/actions/main/in/GripScale"
            }
          }
        },
        {
          "mode": "joystick",
          "path": "/user/hand/left/input/thumbstick",
          "inputs": {
            "click": {
              "output": "/actions/main/in/ClearTranslation"
            }
          }
        },
        {
          "mode": "joystick",
          "path": "/user/hand/right/input/thumbstick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/MenuNavigate"
            }
          }
        }
      ]
    }
  },
  "description": "Default bindings for HTC Vive Cosmos Controllers"
}
